{
  "name": "bug-vault",
  "version": "1.0.0",
  "description": "Ambiente de homologação e testes automatizados E2E para o Freedoom em WebAssembly",
  "scripts": {
    "serve": "http-server public -p 4173 -a 127.0.0.1 -c-1",
